        <record id="integration_prestashop_account_tax_21" model="account.tax">
            <field name="name">IVA ES 21%</field>
            <field name="amount">21.0</field>
            <field name="description">21.0%</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="price_include" eval="True"/>
            <field name="tax_group_id" ref="integration_prestashop_account_tax_group_21"/>
            <field name="company_id" ref="test_integration_company_prestashop_nl"/>
            <field name="integration_id" ref="integration_prestashop_test_1"/>
        </record>

        <record id="integration_prestashop_account_tax_mapping_23" model="integration.account.tax.mapping">
            <field name="external_tax_id" ref="integration_prestashop_account_tax_external_21"/>
            <field name="tax_id" ref="integration_prestashop_account_tax_21"/>
            <field name="integration_id" ref="integration_prestashop_test_1"/>
