<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="test_integration_company_prestashop_nl" model="res.company">
            <field name="name">Test Integration Company NL</field>
            <field name="currency_id" ref="base.EUR"/>
            <field name="country_id" ref="base.nl"/>
        </record>

        <!-- Account -->
        <record id="integration_prestashop_account_a_income" model="account.account">
            <field name="code">X2020</field>
            <field name="name">Sales of Product Income (Prestashop test)</field>
            <field name="account_type">income</field>
            <field name="company_ids" eval="[(4, ref('test_integration_company_prestashop_nl'))]"/>
        </record>
        <record id="integration_prestashop_account_a_expense" model="account.account">
            <field name="code">X2120</field>
            <field name="name">Cost of Goods Sold (Prestashop test)</field>
            <field name="account_type">expense</field>
            <field name="company_ids" eval="[(4, ref('test_integration_company_prestashop_nl'))]"/>
        </record>
        <record id="integration_prestashop_account_a_recv" model="account.account">
            <field name="code">X1012</field>
            <field name="name">Debtors - (Prestashop test)</field>
            <field name="account_type">asset_receivable</field>
            <field name="reconcile" eval="True"/>
            <field name="company_ids" eval="[(4, ref('test_integration_company_prestashop_nl'))]"/>
        </record>
        <record id="integration_prestashop_account_a_pay" model="account.account">
            <field name="code">X1111</field>
            <field name="name">Accounts Payable (A/P) (Prestashop test)</field>
            <field name="account_type">liability_payable</field>
            <field name="company_ids" eval="[(4, ref('test_integration_company_prestashop_nl'))]"/>
        </record>
        <record id="integration_prestashop_account_a_rsa" model="account.account">
            <field name="code">X1113</field>
            <field name="name">Reserve and Profit/Loss - (Prestashop test)</field>
            <field name="account_type">asset_receivable</field>
            <field name="company_ids" eval="[(4, ref('test_integration_company_prestashop_nl'))]"/>
        </record>
        <record id="integration_prestashop_account_a_cas" model="account.account">
            <field name="code">X1010</field>
            <field name="name">Current Assets - (Prestashop test)</field>
            <field name="account_type">asset_current</field>
            <field name="company_ids" eval="[(4, ref('test_integration_company_prestashop_nl'))]"/>
        </record>

        <!-- Account Journal -->
        <record id="integration_prestashop_account_sales_journal_test" model="account.journal">
            <field name="name">Customer Invoices Prestashop Test</field>
            <field name="code">TINV</field>
            <field name="type">sale</field>
            <field name="refund_sequence" eval="True"/>
            <field name="default_account_id" ref="integration_prestashop_account_a_income"/>
            <field name="company_id" ref="test_integration_company_prestashop_nl"/>
        </record>

        <record id="integration_prestashop_account_cash_journal" model="account.journal">
            <field name="name">Cash Prestashop Test</field>
            <field name="code">TCSH</field>
            <field name="type">cash</field>
            <field name="profit_account_id" ref="integration_prestashop_account_a_rsa"/>
            <field name="loss_account_id" ref="integration_prestashop_account_a_rsa"/>
            <field name="company_id" ref="test_integration_company_prestashop_nl"/>
        </record>

        <!-- Payment methods -->
        <record id="integration_prestashop_method_manual_in" model="account.payment.method">
            <field name="name">Manual Prestashop In</field>
            <field name="code">manual_in_prestashop_test</field>
            <field name="payment_type">inbound</field>
        </record>

        <!-- Payment method line -->
        <record id="integration_prestashop_line_check_in" model="account.payment.method.line">
            <field name="journal_id" ref="integration_prestashop_account_cash_journal"/>
            <field name="payment_account_id" ref="integration_prestashop_account_a_cas"/>
            <field name="payment_method_id" ref="integration_prestashop_method_manual_in"/>
        </record>

        <!-- Integration -->
        <record id="integration_prestashop_test_1" model="sale.integration">
            <field name="name">IntegrationPrestashopTest</field>
            <field name="type_api">prestashop</field>
            <field name="company_id" ref="test_integration_company_prestashop_nl"/>
            <field name="state">active</field>
            <field name="integration_lang_id" ref="base.lang_nl"/>
            <field name="export_template_job_enabled">False</field>
            <field name="allow_export_images">False</field>
            <field name="auto_create_delivery_carrier_on_so">True</field>
            <field name="mandatory_fields_initial_product_export" eval="[(6, 0, (ref('product.field_product_product__default_code'),))]"/>
        </record>

        <!-- Taxes -->
        <record id="integration_prestashop_account_tax_external_21" model="integration.account.tax.external">
            <field name="code">25</field>
            <field name="name">IVA ES 21%</field>
