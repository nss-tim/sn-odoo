<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="integration_auth_prestashop_form_authentication" model="ir.ui.view">
        <field name="name">integration.auth.prestashop.form.authentication</field>
        <field name="model">integration.auth.prestashop</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="authentication,authorization"/>
                </header>
                <sheet string="Connection Authentication">
                    <field name="integration_id" readonly="1" invisible="1" /> <!-- Required because it is used in the fields domains in the model -->

                    <group string="PrestaShop Credentials">
                        <field name="url" required="not access_granted" readonly="access_granted"/>
                        <field name="admin_url" required="not access_granted" readonly="access_granted"/>
                        <field name="key" required="not access_granted" readonly="access_granted" password="True"/>
                    </group>

                    <group string="Status">
                        <field name="access_granted" invisible="1"/> <!-- Required because it is used in the invisible condition below -->
                        <field name="error_message" invisible="1"/> <!-- Required because it is used in the invisible condition below -->
                        <field name="error_traceback" invisible="1"/> <!-- Required because it is used in the invisible condition below -->
                        <div class="d-flex align-items-center mt-2" colspan="2">
                            <span class="badge rounded-pill d-flex align-items-center integration-api-badge-button"
                                  invisible="not access_granted"
                                  title="API Access Granted">
                                <i class="fa fa-check-circle me-2" style="font-size: 1.1rem;" title="API Access Granted"/>
                                <span>API Access Granted</span>
                            </span>
                            <span class="badge rounded-pill d-flex align-items-center integration-api-badge-button api-access-not-granted"
                                  invisible="access_granted"
                                  title="API Access Not Granted">
                                <i class="fa fa-exclamation-circle me-2" style="font-size: 1.1rem;" title="API Access Not Granted"/>
                                <span>API Access Not Granted</span>
                            </span>
                        </div>
                    </group>
                    <div class="alert alert-warning clearfix" role="alert" invisible="not error_message">
                        <p><b>An error occurred</b></p>
                        <p>Please review the error details below and correct your credentials if needed.</p>
                        <p class="mb-2"><b>Error Message:</b></p>
                        <p class="mb-3"><field name="error_message" nolabel="1" readonly="1" widget="text"/></p>
                        <div class="accordion" id="errorAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <a href="#" class="accordion-button collapsed" role="button" data-bs-toggle="collapse" data-bs-target="#errorCollapse" aria-expanded="false" aria-controls="errorCollapse">
                                        See full traceback
                                    </a>
                                </h2>
                                <div id="errorCollapse" class="accordion-collapse collapse" data-bs-parent="#errorAccordion">
                                    <div class="accordion-body">
                                        <div class="alert alert-danger o_error_detail mb-0" role="alert" invisible="not error_traceback">
                                            <pre><field name="error_traceback" nolabel="1" readonly="1" widget="text"/></pre>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <!-- Main buttons -->
                    <button name="connect_to_ecommerce_store"
                        string="Connect to PrestaShop →"
                        type="object"
                        class="btn-primary me-4"
                        invisible="access_granted"
                    />
                    <button name="check_access_permissions"
                        string="Check Access Permissions →"
                        type="object"
                        class="btn-primary me-4"
                        invisible="not access_granted"
                    />

                    <!-- Secondary buttons -->
                    <button name="test_connection"
                        string="Test Connection"
                        type="object"
                        class="btn-outline-secondary"
                        invisible="not access_granted"
                    />
                    <button name="reset_credentials"
                        string="Reset Credentials"
                        type="object"
                        class="btn-outline-danger"
                        invisible="not access_granted"
                    />

                    <!-- Help & Support -->
                    <a href="https://support.ventor.tech/"
                       role="button"
                       target="_blank"
                       class="btn btn-outline-info ms-auto">Help &amp; Support</a>
                </footer>
            </form>
        </field>
    </record>

    <record id="integration_auth_prestashop_form_authorization" model="ir.ui.view">
        <field name="name">integration.auth.prestashop.form.authorization</field>
        <field name="model">integration.auth.prestashop</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="authentication,authorization"/>
                </header>
                <sheet string="Access Permissions">
                    <group string="Access Permissions">
                        <field name="is_valid_access_scopes" invisible="1"/> <!-- Required because it is used in the invisible condition below -->
                        <div class="alert alert-info" colspan="2" role="alert" invisible="is_valid_access_scopes">
                            Listed below permissions needed to be enabled on Prestashop side, so connector will work properly.
                            If you see some "red lines" below, then listed permission were not granted.
                        </div>
                        <field name="configuration_scope_ids" colspan="2" nolabel="1">
                                <list>
                                    <field name="resource_name"/>
                                    <field name="method_get" widget="badge" decoration-success="method_get == 'yes'" decoration-danger="method_get == 'no'"/>
                                    <field name="method_put" widget="badge" decoration-success="method_put == 'yes'" decoration-danger="method_put == 'no'"/>
                                    <field name="method_post" widget="badge" decoration-success="method_post == 'yes'" decoration-danger="method_post == 'no'"/>
                                    <field name="method_delete" widget="badge" decoration-success="method_delete == 'yes'" decoration-danger="method_delete == 'no'"/>
                                    <field name="method_required" widget="badge" decoration-success="method_required == 'yes'" decoration-danger="method_required == 'no'"/>
                                </list>
                        </field>
                    </group>
                    <div class="alert alert-warning" role="alert"
                        invisible="is_valid_access_scopes">
                        Please ensure all permissions listed in the table above are granted
                        before continuing to configuration. Otherwise, you may encounter
                        errors during the connector's operation.
                    </div>
                </sheet>
                <footer>
                    <button name="open_form_authentication"
                        string="← Back"
                        type="object"
                        class="btn-outline-primary"
                    />
                    <button name="continue_to_configuration"
                        string="Continue to Configuration →"
                        type="object"
                        class="btn-primary"
                        invisible="not is_valid_access_scopes"
                    />
                    <button string="Continue to Configuration →"
                        class="btn-primary disabled opacity-50"
                        invisible="is_valid_access_scopes"
                    />
                    <button name="check_access_permissions"
                        string="Check Access Permissions"
                        type="object"
                        class="btn-primary ms-auto"
                        invisible="is_valid_access_scopes"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_view_prestashop_integration_authentication" model="ir.actions.act_window">
        <field name="name">Connect to PrestaShop</field>
        <field name="path">eci-prestashop-authentication</field>
        <field name="res_model">integration.auth.prestashop</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="integration_prestashop.integration_auth_prestashop_form_authentication"/>
        <field name="target">new</field>
    </record>

    <record id="action_view_prestashop_integration_authorization" model="ir.actions.act_window">
        <field name="name">Check PrestaShop Permissions</field>
        <field name="path">eci-prestashop-authorization</field>
        <field name="res_model">integration.auth.prestashop</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="integration_prestashop.integration_auth_prestashop_form_authorization"/>
        <field name="target">new</field>
    </record>

</odoo>
