<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_prestashop_external_integration_tag_tree" model="ir.ui.view">
            <field name="name">external.integration.tag.list</field>
            <field name="model">external.integration.tag</field>
            <field name="arch" type="xml">
                <list editable="bottom" create="1">
                    <field name="integration_id" options="{'no_create': True}" domain="[('type_api', '=', 'prestashop')]"/>
                    <field name="external_language_id" options="{'no_create': True}" readonly="not integration_id" domain="[('integration_id', '=', integration_id)]"/>
                    <field name="name" readonly="not external_language_id"/>
                </list>
            </field>
        </record>

        <record id="view_prestashop_external_integration_tag_form" model="ir.ui.view">
            <field name="name">external.integration.tag.form</field>
            <field name="model">external.integration.tag</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="integration_id" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="external_language_id"
                               readonly="not integration_id"
                               domain="[('integration_id', '=', integration_id)]"
                               options="{'no_create': True, 'no_edit': True}"/>
                        <field name="name" readonly="not external_language_id"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_external_integration_prestashop_product_tag" model="ir.actions.act_window">
            <field name="name">External Product Tags (Prestashop)</field>
            <field name="path">eci-external-integration-prestashop-product-tags</field>
            <field name="res_model">external.integration.tag</field>
            <field name="domain">[('ttype', '=', 'product'), ('integration_id.type_api', '=', 'prestashop')]</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_prestashop_external_integration_tag_tree"/>
        </record>

    </data>
</odoo>
