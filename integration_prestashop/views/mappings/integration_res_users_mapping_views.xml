<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="integration_res_users_mapping_view_tree" model="ir.ui.view">
            <field name="name">integration.res.users.mapping.view.list</field>
            <field name="model">integration.res.users.mapping</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="id" groups="base.group_no_one"/>
                    <field name="integration_id"/>
                    <field name="external_user_id"/>
                    <field name="user_id" context="{'active_test': False}"/>
                </list>
            </field>
        </record>

        <record id="integration_res_users_mapping_view_search" model="ir.ui.view">
            <field name="name">integration.res.users.mapping.view.search</field>
            <field name="model">integration.res.users.mapping</field>
            <field name="arch" type="xml">
                <search>
                    <field name="user_id"/>
                    <field name="external_user_id"/>
                    <field name="integration_id"/>
                    <group>
                        <filter string="E-Commerce Store" name="group_by_integration_id" context="{'group_by': 'integration_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="integration_res_users_mapping_action" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="path">eci-employee-mappings</field>
            <field name="res_model">integration.res.users.mapping</field>
            <field name="view_mode">list</field>
        </record>

    </data>
</odoo>
