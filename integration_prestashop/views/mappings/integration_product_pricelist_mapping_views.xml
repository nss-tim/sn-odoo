<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="integration_product_pricelist_mapping_view_tree_prestashop" model="ir.ui.view">
            <field name="name">integration.product.pricelist.mapping.view.list.prestashop</field>
            <field name="model">integration.product.pricelist.mapping</field>
            <field name="inherit_id" ref="integration.integration_product_pricelist_mapping_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='external_pricelist_id']" position="attributes">
                    <attribute name="string">PrestaShop Customer Group</attribute>
                </xpath>

                <xpath expr="//field[@name='pricelist_id']" position="after">
                    <button name="import_special_prices_mapping"
                            type="object"
                            string="Synchronize"
                            invisible="not pricelist_id"
                            icon="fa-refresh"
                            class="btn-outline-primary"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
