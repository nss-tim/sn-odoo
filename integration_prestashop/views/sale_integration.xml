<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_sale_integration_form" model="ir.ui.view">
            <field name="name">sale.integration.form</field>
            <field name="model">sale.integration</field>
            <field name="inherit_id" ref="integration.view_sale_integration_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='inventory_defaults']/group/group[@name='advanced_inventory_settings']" position="inside">
                    <field name="shared_stock" widget="boolean_toggle" invisible="not is_integration_prestashop"/>
                </xpath>
                <field name="default_sales_team_id" position="after">
                    <div class="alert alert-info mb-1" role="alert" colspan="2"
                         invisible="not is_integration_prestashop">
                        You can assign a specific Sales Team per PrestaShop customer group
                        using the mapping table below. The group-specific team takes priority;
                        the <strong>Default Sales Team</strong> above acts as a fallback when
                        no mapping is defined for the customer's group.
                    </div>
                    <field name="customer_group_mapping_ids"
                           invisible="not is_integration_prestashop"
                           nolabel="1"
                           colspan="2">
                        <list editable="bottom">
                            <field name="external_customer_group_id"
                                   domain="[('integration_id', '=', parent.id)]"
                                   options="{'no_create': True}"/>
                            <field name="sales_team_id"
                                   options="{'no_create': True}"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                        </list>
                    </field>
                </field>
                <xpath expr="//div[@id='export_sale_order_status_job_enabled_note']" position="after">
                    <field name="force_user_on_order_status_change" widget="boolean_toggle" invisible="not is_integration_prestashop"/>
                    <p class="o_wrap_label" invisible="not is_integration_prestashop"/> <!-- Spacer: aligns the note under the field column -->
                    <div class="text-muted mb-4" invisible="not is_integration_prestashop">
                        Requires mapping Odoo users to PrestaShop employees (under Mappings). If a user is not mapped, the status change is still sent, but without an employee.
                    </div>
                </xpath>
                <field name="is_import_dynamic_attribute" position="after">
                    <field name="delivery_time" invisible="not is_integration_prestashop"/>
                    <field name="product_delivery_in_stock" invisible="not is_integration_prestashop or delivery_time != 'specific'" required="delivery_time == 'specific'"/>
                    <field name="message_template_in_stock" invisible="not is_integration_prestashop or delivery_time != 'specific'" required="delivery_time == 'specific'"/>
                    <field name="product_delivery_out_of_stock" invisible="not is_integration_prestashop or delivery_time != 'specific'" required="delivery_time == 'specific'"/>
                    <field name="message_template_out_of_stock" invisible="not is_integration_prestashop or delivery_time != 'specific'" required="delivery_time == 'specific'"/>
                </field>
                <group name="product_synchronization_settings" position="after">
                    <group name="category_and_inventory_settings" string="Category and Inventory Settings" groups="base.group_no_one" invisible="id == False or not is_integration_prestashop">
                        <field name="import_inactive_categories" groups="base.group_no_one" invisible="id == False or not is_integration_prestashop" widget="boolean_toggle"/>
                    </group>
                </group>
                <group name="ecommerce_fields_mappings" position="inside">
                    <field name="subscribed_to_newsletter_id" invisible="id == False or not is_integration_prestashop"/>
                    <field name="newsletter_registration_date_id" invisible="id == False or not is_integration_prestashop"/>
                    <field name="customer_registration_date_id" invisible="id == False or not is_integration_prestashop"/>
                    <field name="additional_address_information" invisible="id == False or not is_integration_prestashop"/>
                    <field name="default_customer_group_field_id" options="{'no_create': True, 'no_edit': True}" invisible="id == False or not is_integration_prestashop"/>
                </group>
                <field name="webhook_line_ids" position="after">
                    <div class="alert alert-warning mb-1" role="alert" colspan="2" invisible="not webhook_line_ids or not is_integration_prestashop">
                        <h5>Why the 'Product Created' Webhook Is Not Used in PrestaShop</h5>
                        <p>
                            'Product Created' triggers before a product is fully saved, often missing key data. By contrast, 'Product Updated' fires once the product is complete. If a new product is detected, it is created; otherwise, it is updated. This approach processes only fully created and published products, avoiding issues caused by incomplete information.
                        </p>
                    </div>
                </field>
                <xpath expr="//group[@name='initial_import_customers']" position="after">
                    <group string="[Optional] Synchronize Related Products"
                           name="initial_import_related_products"
                           invisible="id == False or not is_integration_prestashop">
                        <div class="row" colspan="2">
                            <div class="col-md-10">
                                <p>
                                    This step is specifically added for users of the PrestaShop
                                    connector. It ensures that your 'Related Products' from
                                    PrestaShop are synchronized with Odoo's 'Optional Products'.
                                    Once you have completed the product linking and mapping
                                    process in Step 2, you can use this function to synchronize
                                    the optional products in Odoo with the related products
                                    defined in your PrestaShop system. It scans through the
                                    related products information in PrestaShop and updates the
                                    'Optional Products' field in Odoo accordingly, maintaining
                                    consistency across both platforms.
                                </p>
                            </div>
                            <div class="col-md-2">
                                <button name="action_import_related_products"
                                        type="object"
                                        string="Synchronize Related Products"
                                        class="btn btn-outline-primary w-100"
                                />
                            </div>
                        </div>
                    </group>
                </xpath>
                <field name="behavior_on_non_existing_invoice" position="after">
                    <div class="alert alert-info p-3" role="alert" invisible="not is_integration_prestashop" colspan="2">
                        <h4>💡 Did You Know?</h4>
                        <p>
                            We offer special module for PrestaShop that work seamlessly with this API route.
                            Once installed, these modules allow your customers to download official Odoo invoices directly from their store account pages.
                        </p>
                        <a class="btn btn-primary mb-3" href="https://ecosystem.ventor.tech/product/odoo-invoice-connector-module-for-prestashop/" role="button" target="_blank">Odoo Invoice Connector – Module for PrestaShop</a>

                        <p class="mb-0">
                            <strong>Make your store feel more professional and automated — no custom coding required!</strong>
                        </p>
                    </div>
                </field>
                <page name="product_default_page" position="after">
                    <page string="Pricelists" name="pricelist_default_page" invisible="not is_integration_prestashop">
                        <group>
                            <group string="Pricelist Settings" name="pricelist_settings" colspan="2">
                                <field name="pricelist_integration" invisible="not is_integration_prestashop" widget="boolean_toggle"/>
                                <field name="last_update_pricelist_items" invisible="not is_integration_prestashop"/>
                            </group>
                        </group>
                        <group string="Pricelist Mappings" name="pricelist_mappings" invisible="not pricelist_integration">
                            <div colspan="2">
                                <group>
                                    <p>
                                        <small>
                                            Use this feature to integrate 'Product Special Prices' from your e-commerce platform into Odoo. Here you can link external pricelists with their corresponding Odoo pricelists and then synchronize them. The synchronization is one-way and pulls special pricing data from your e-commerce system to update the pricelists in Odoo, ensuring your system reflects the most up-to-date pricing strategies.
                                        </small>
                                    </p>
                                </group>
                            </div>
                            <div colspan="2">
                                <button name="run_export_special_prices" string="Export Pricelists to PrestaShop" type="object" class="btn btn-primary"/>
                            </div>
                            <div colspan="2" class="mt-2">
                                <small class="text-muted me-2">One-time setup:</small>
                                <button name="fetch_pricelist_from_external" string="Fetch Customer Groups" type="object" class="btn btn-secondary btn-sm me-2"/>
                                <button name="run_import_special_prices" string="Import Special Prices" type="object" class="btn btn-secondary btn-sm"/>
                            </div>
                            <div colspan="2">
                                <field name="pricelist_mapping_ids" nolabel="1"/>
                            </div>
                        </group>
                    </page>
                </page>
            </field>
        </record>
    </data>
</odoo>
